# Copy to .env.local and set the API URL for how you're running the backend.
# Vite only exposes variables prefixed with VITE_ to the browser.
# Don't put secrets here; anything VITE_* ends up in the built JS bundle.

# Option A: API running in Docker
VITE_API_BASE_URL=http://localhost:8080

# Option B: API running with `dotnet run`
# VITE_API_BASE_URL=http://localhost:5065
